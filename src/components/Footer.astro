---
import { config } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-content">
		<nav class="footer-nav">
			<a href="/">Home</a>
			<a href="/about">About</a>
			<a href="/speaking">Speaking</a>
			<a href="/media">Media</a>
			<a href="/advisory">Advisory</a>
			<a href="/projects">Projects</a>
			<a href="/blog">Blog</a>
		</nav>

		<div class="footer-social">
			<a href={config.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
				<i class="fab fa-linkedin"></i>
			</a>
			<a href={config.social.twitter} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
				<i class="fab fa-x-twitter"></i>
			</a>
			<a href={config.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<i class="fab fa-github"></i>
			</a>
			<a href={`mailto:${config.social.email}`} aria-label="Email">
				<i class="fas fa-envelope"></i>
			</a>
		</div>

		<div class="footer-built-with">
			<a href="https://www.anthropic.com/claude-code" target="_blank" rel="noopener noreferrer"><i class="fas fa-robot"></i> Claude Code</a>
			<span class="separator">|</span>
			<a href="https://astro.build/" target="_blank" rel="noopener noreferrer"><i class="fas fa-rocket"></i> Astro</a>
			<span class="separator">|</span>
			<a href="https://workers.cloudflare.com/" target="_blank" rel="noopener noreferrer"><i class="fas fa-cloud"></i> Cloudflare Workers</a>
		</div>

		<p class="footer-copyright">
			&copy; {currentYear} {config.author.name}. All rights reserved.
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 4px solid var(--color-accent);
		background-color: var(--color-surface);
		padding: calc(var(--grid-unit) * 6) var(--content-padding);
		margin-top: calc(var(--grid-unit) * 8);
	}

	.footer-content {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(var(--grid-unit) * 3);
	}

	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: calc(var(--grid-unit) * 2) calc(var(--grid-unit) * 4);
	}

	.footer-nav a {
		font-family: var(--font-heading-secondary);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.875rem;
		color: var(--color-text-secondary);
		transition: color 0.2s ease;
	}

	.footer-nav a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.footer-social {
		display: flex;
		gap: calc(var(--grid-unit) * 3);
	}

	.footer-social a {
		font-size: 1.25rem;
		color: var(--color-text-secondary);
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.footer-social a:hover {
		color: var(--color-accent);
		transform: translateY(-2px);
	}

	.footer-built-with {
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.footer-built-with a {
		color: var(--color-text-muted);
		transition: color 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.footer-built-with a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.footer-built-with .separator {
		margin: 0 calc(var(--grid-unit));
		opacity: 0.5;
	}

	.footer-copyright {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		margin: 0;
	}

	@media (max-width: 768px) {
		.site-footer {
			padding: calc(var(--grid-unit) * 4) var(--content-padding);
		}

		.footer-nav {
			gap: calc(var(--grid-unit) * 2);
		}

		.footer-nav a {
			font-size: 0.75rem;
		}
	}
</style>
